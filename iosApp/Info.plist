<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>BetterTrack</string>
	<key>CFBundleExecutable</key>
	<string>BetterTrack</string>
	<key>CFBundleIdentifier</key>
	<string>at.bettertrack.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>BetterTrack</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneSimulator</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<!-- Gives the app the full screen without a storyboard. Omitting it makes
	     UIKit letterbox the window to a legacy size, so Compose renders into a
	     small centred box instead of edge-to-edge. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- MANDATORY for Compose Multiplatform. Without this exact key CMP does not
	     merely look wrong, it REFUSES to start:
	       kotlin.IllegalStateException: Error: Info.plist doesnt have a valid
	       CADisableMinimumFrameDurationOnPhone entry
	     CMP asserts on it so it can drive the display link above 60 Hz on
	     ProMotion hardware. Never remove it. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
