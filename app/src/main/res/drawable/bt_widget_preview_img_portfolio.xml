<?xml version="1.0" encoding="utf-8"?>
<!--
  Portfolio widget: name, value, and the gold 1M curve.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the
  matching res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="100dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="102dp"
        android:bottom="79dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_muted" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="130dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="79dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gain" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="27dp"
        android:right="72dp"
        android:bottom="58dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="52dp"
        android:right="14dp"
        android:bottom="12dp"
        android:drawable="@drawable/bt_widget_preview_curve" />
</layer-list>
