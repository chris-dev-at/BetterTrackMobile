<?xml version="1.0" encoding="utf-8"?>
<!--
  Budget widget: one budget as a progress ring.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the
  matching res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="100dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="20dp"
        android:right="86dp"
        android:bottom="20dp"
        android:drawable="@drawable/bt_widget_preview_ring" />
    <item
        android:left="86dp"
        android:top="34dp"
        android:right="24dp"
        android:bottom="54dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:left="86dp"
        android:top="54dp"
        android:right="14dp"
        android:bottom="38dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_muted" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
