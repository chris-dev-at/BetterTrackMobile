<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-actions widget: two shortcut tiles.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the matching
  res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="50dp" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="12dp"
        android:right="84dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_chip" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="86dp"
        android:top="12dp"
        android:right="10dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_chip" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="21dp"
        android:right="118dp"
        android:bottom="21dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gold" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="94dp"
        android:top="21dp"
        android:right="42dp"
        android:bottom="21dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gold" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
