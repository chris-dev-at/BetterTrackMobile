<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick Links widget: four launcher tiles.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the matching
  res/layout preview, which draws the real pictograms). Sizes are dp at 1x.

  Rewritten for the round-3 icon grid — it used to show the two text tiles of
  the Quick-actions design. A layer-list cannot host a vector, so each tile is
  the squircle with a gold mark centred in it; the layout preview above carries
  the actual glyphs.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="50dp" />
        </shape>
    </item>
    <!-- Tile 1 -->
    <item
        android:left="10dp"
        android:top="7dp"
        android:right="124dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_chip" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="19dp"
        android:top="16dp"
        android:right="133dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gold" />
            <corners android:radius="2dp" />
        </shape>
    </item>
