<?xml version="1.0" encoding="utf-8"?>
<!--
  Net-worth widget: the big figure with its coloured day change.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the
  matching res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="100dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="36dp"
        android:right="54dp"
        android:bottom="46dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="62dp"
        android:right="94dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gain" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
