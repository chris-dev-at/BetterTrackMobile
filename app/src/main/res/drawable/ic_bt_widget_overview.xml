<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-Links pictogram: the all-portfolios landing view.

  Traced verbatim from the round-3 Codex study's `#i-overview` symbol (24x24
  viewBox, 1.8 stroke, round caps and joins); the study's <rect rx> shapes are
  the same geometry written as pathData, which is all a VectorDrawable takes.

  Drawn in WHITE on purpose: every Quick-Links glyph is tinted at render time
  (`ColorFilter.tint(colors.gold)`) so one drawable serves the live widget's
  day and night gold, the forced-theme palettes, and the picker preview. A
  baked colour here would need a values-night twin per icon for no gain.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/bt_widget_gold">
    <path
        android:pathData="M5.1,3.5 h3.8 a1.6,1.6 0 0 1 1.6,1.6 v3.8 a1.6,1.6 0 0 1 -1.6,1.6 h-3.8 a1.6,1.6 0 0 1 -1.6,-1.6 v-3.8 a1.6,1.6 0 0 1 1.6,-1.6 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M15,3.5 h4 a1.5,1.5 0 0 1 1.5,1.5 v1.5 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-1.5 a1.5,1.5 0 0 1 1.5,-1.5 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M5.1,13.5 h3.8 a1.6,1.6 0 0 1 1.6,1.6 v3.8 a1.6,1.6 0 0 1 -1.6,1.6 h-3.8 a1.6,1.6 0 0 1 -1.6,-1.6 v-3.8 a1.6,1.6 0 0 1 1.6,-1.6 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M15.1,11 h3.8 a1.6,1.6 0 0 1 1.6,1.6 v6.3 a1.6,1.6 0 0 1 -1.6,1.6 h-3.8 a1.6,1.6 0 0 1 -1.6,-1.6 v-6.3 a1.6,1.6 0 0 1 1.6,-1.6 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
