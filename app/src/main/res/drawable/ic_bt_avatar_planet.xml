<?xml version="1.0" encoding="utf-8"?>
<!--
  Curated profile avatar `planet` — a literal port of the web's
  apps/web/src/user/components/profileIcons.tsx renderer (same monorepo,
  drawn in-house, no icon dependency). Multicolour ARTWORK: never tinted.
  The 64x64 rx=12 tile is the web's own <rect> and is clipped to a circle
  by BtAvatar, matching origin.css `border-radius: 50%`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- tile -->
    <path
        android:fillColor="#FF132139"
        android:pathData="M12,0 H52 A12,12 0 0,1 64,12 V52 A12,12 0 0,1 52,64 H12 A12,12 0 0,1 0,52 V12 A12,12 0 0,1 12,0 Z" />

    <path
        android:fillColor="#FF7BBCFF"
        android:pathData="M20,32 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />

    <group
        android:pivotX="32"
        android:pivotY="32"
        android:rotation="-20">

        <path
            android:strokeColor="#FFFF9F6B"
            android:strokeWidth="3"
            android:pathData="M10,32 a22,6 0 1,0 44,0 a22,6 0 1,0 -44,0 Z" />
    </group>

    <path
        android:fillColor="#FFFF9F6B"
        android:fillAlpha="0.7"
        android:pathData="M24,30 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />

</vector>
