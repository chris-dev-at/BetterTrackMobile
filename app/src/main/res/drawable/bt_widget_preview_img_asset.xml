<?xml version="1.0" encoding="utf-8"?>
<!--
  Asset widget: gold symbol, bold price, coloured day move.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the
  matching res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="50dp" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:top="10dp"
        android:right="110dp"
        android:bottom="33dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gold" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:top="23dp"
        android:right="82dp"
        android:bottom="13dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:left="120dp"
        android:top="20dp"
        android:right="12dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gain" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
