<?xml version="1.0" encoding="utf-8"?>
<!--
  Cash Wallet widget: source line, balance, and the two posting buttons.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the matching
  res/layout preview with real text). Sizes are dp at 1x.

  The two action blocks carry the money-direction washes — red left, emerald
  right — because their ORDER and their colours are the thing that identifies
  this widget at thumbnail size.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="86dp" />
        </shape>
    </item>
    <!-- The subject dot. -->
    <item
        android:left="12dp"
        android:top="13dp"
        android:right="144dp"
        android:bottom="69dp">
        <shape android:shape="oval">
            <solid android:color="@color/bt_widget_gold" />
        </shape>
    </item>
    <!-- The source name. -->
    <item
        android:left="20dp"
        android:top="14dp"
        android:right="96dp"
        android:bottom="70dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_muted" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- The balance. -->
    <item
        android:left="12dp"
        android:top="24dp"
        android:right="72dp"
        android:bottom="46dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_primary" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Bezahlt. -->
    <item
        android:left="12dp"
        android:top="52dp"
        android:right="84dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_loss_wash" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="30dp"
        android:top="62dp"
        android:right="102dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_loss" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Erhalten. -->
    <item
        android:left="84dp"
        android:top="52dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gain_wash" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:left="102dp"
        android:top="62dp"
        android:right="30dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_gain" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
