<?xml version="1.0" encoding="utf-8"?>
<!--
  Spending widget: the month as a donut with a tag legend.
  Pre-API-31 picker preview image (SAMPLE rendering; API 31+ uses the
  matching res/layout preview with real text). Sizes are dp at 1x.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_surface" />
            <corners android:radius="20dp" />
            <size
                android:width="160dp"
                android:height="100dp" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="16dp"
        android:right="78dp"
        android:bottom="16dp"
        android:drawable="@drawable/bt_widget_preview_donut" />
    <item
        android:left="96dp"
        android:top="24dp"
        android:right="14dp"
        android:bottom="68dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_secondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="96dp"
        android:top="46dp"
        android:right="22dp"
        android:bottom="46dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_secondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="96dp"
        android:top="68dp"
        android:right="18dp"
        android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bt_widget_text_secondary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
