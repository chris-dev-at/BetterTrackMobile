<?xml version="1.0" encoding="utf-8"?>
<!--
  Curated profile avatar `compass` — a literal port of the web's
  apps/web/src/user/components/profileIcons.tsx renderer (same monorepo,
  drawn in-house, no icon dependency). Multicolour ARTWORK: never tinted.
  The 64x64 rx=12 tile is the web's own <rect> and is clipped to a circle
  by BtAvatar, matching origin.css `border-radius: 50%`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- tile -->
    <path
        android:fillColor="#FF0F2A34"
        android:pathData="M12,0 H52 A12,12 0 0,1 64,12 V52 A12,12 0 0,1 52,64 H12 A12,12 0 0,1 0,52 V12 A12,12 0 0,1 12,0 Z" />

    <path
        android:fillColor="#FF8CD6D1"
        android:pathData="M14,32 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 Z" />

    <path
        android:fillColor="#FFE8FBF9"
        android:strokeColor="#FFE8FBF9"
        android:strokeWidth="1"
        android:strokeLineJoin="round"
        android:pathData="M32 16l6 16-6 16-6-16z" />

    <path
        android:fillColor="#FF8CD6D1"
        android:pathData="M29,32 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />

</vector>
