<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand tokens mirrored from the Compose theme (B2 design spec §1.4) for XML
      use (window background, launcher icon, splash).

      THIS FILE IS THE LIGHT TABLE; res/values-night/colors.xml carries the dark
      one. Only the values that actually differ are overridden there.

      The Compose tokens are alpha hairlines over a surface; XML has no substrate
      to composite against, so bt_border is the flattened result over bt_surface.
    -->
    <color name="bt_bg">#FFFFFFFF</color>
    <color name="bt_surface">#FFF2F4F7</color>
    <color name="bt_border">#FFDCDEE2</color>
    <!-- Constant across modes: gold is the brand, and brand does not flip. -->
    <color name="bt_gold">#FFF6B82E</color>

    <!--
      The splash canvas — and the one colour here that does NOT flip.

      B2-A's `bt_window_bg` pinned BOTH the window and the splash to the dark
      page colour, because until `BtThemeFeatures.LIGHT_MODE_PUBLIC` opened, the
      app rendered dark on every system and a light-system phone would have
      flashed white before Compose drew. B2-B opened that gate, so the WINDOW
      background now follows the real `bt_bg` token per configuration and that
      pin is gone.

      The SPLASH keeps a dark canvas on purpose, in both configurations. The
      brand mark it carries (@drawable/splash_bt_glyph) is a WHITE "B" beside a
      gold "T" — artwork drawn for a dark ground. On the light page colour the
      B disappears entirely and the gold T sits at 1.78:1, so following the
      configuration here would ship an invisible logo. A fixed dark brand
      moment before a light app is a normal, deliberate pattern; an invisible
      wordmark is a bug.

      That stays true for THIS name, and only for this name. The splash frame is
      drawn by the window manager before Compose exists, so it cannot read the
      app's theme preference at all — it gets a fixed brand ground and the baked
      raster, which is correct for it.

      Everywhere INSIDE the app the raster is gone (2026-09-02, owner order): the
      login screen's monogram is `BtBrandmark`, which tints two colourless alpha
      masks split from this same artwork — the silhouette in the theme's
      on-background ink, the "T" in the brand gold on top. That is the
      "light-ground variant" this comment used to ask for, generalised: it is
      every ground, including true black, rather than a second baked file.
    -->
    <color name="bt_splash_bg">#FF0A0D12</color>

    <!-- Launcher-icon tile color, sampled exactly from BT_AppIcon.png so the
         foreground's full-bleed tile blends invisibly into the background layer. -->
    <color name="bt_icon_bg">#FF111315</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Home-screen widget PICKER PREVIEW palette — the day side of the exact
      values BtGlanceColor carries for the live widgets (the night side lives in
      values-night). The preview layouts in res/layout/bt_widget_preview_*.xml
      are inflated by the LAUNCHER, which cannot run Glance, so the mirror has to
      exist once more as plain resources. BtWidgetPreviewPaletteTest pins every
      value here to BtGlanceColor so the picker cannot drift from the shipped
      widget. bt_widget_surface is deliberately NOT bt_surface: the widget card
      is BtGlanceColor.Surface (#FFFFFF light), one step above the app's page.
    -->
    <color name="bt_widget_surface">#FFFBFBF9</color>
    <color name="bt_widget_track">#FFD9D9D4</color>
    <color name="bt_widget_text_primary">#FF131820</color>
    <color name="bt_widget_text_secondary">#FF3E4650</color>
    <color name="bt_widget_text_muted">#FF56616D</color>
    <color name="bt_widget_gold">#FFD49E28</color>
    <color name="bt_widget_gain">#FF0F7853</color>
    <color name="bt_widget_loss">#FFB23A4E</color>
    <!-- The gold area wash under a preview curve — gold at ~13% alpha. -->
    <color name="bt_widget_gold_wash">#22D49E28</color>
    <!-- Preview stand-ins for the spending donut's first slices (chart series 1–3). -->
    <color name="bt_widget_series_1">#FF1F6AC4</color>
    <color name="bt_widget_series_2">#FFB8431A</color>
    <color name="bt_widget_series_3">#FF12805B</color>
    <!-- Round 2: the delta-pill washes and the context-chip fill (BtGlanceColor twins). -->
    <color name="bt_widget_chip">#FFEFEFEB</color>
    <color name="bt_widget_gain_wash">#FFDFEBE5</color>
    <color name="bt_widget_loss_wash">#FFF2E4E4</color>
    <color name="bt_widget_on_gold">#FF171105</color>
</resources>
