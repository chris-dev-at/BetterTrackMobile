<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview (API 31+) for the pulse widget — SAMPLE DATA ONLY. The study's
  2x1: gold-dot subject row, big figure, tinted delta pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bt_widget_preview_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_widget_preview_dot"
            android:textColor="@color/bt_widget_gold"
            android:textSize="7sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/bt_widget_pulse_all"
            android:textColor="@color/bt_widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/bt_widget_preview_time"
            android:textColor="@color/bt_widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/bt_widget_preview_networth_value"
            android:textColor="@color/bt_widget_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bt_widget_preview_pill_gain"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp"
            android:text="@string/bt_widget_preview_networth_day"
            android:textColor="@color/bt_widget_gain"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
