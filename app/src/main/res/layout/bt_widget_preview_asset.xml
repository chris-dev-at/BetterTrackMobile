<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview (API 31+) for the asset widget — SAMPLE DATA ONLY. The study's
  2x1: dot + symbol + currency chip, name·exchange subline, price, delta pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bt_widget_preview_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_widget_preview_dot"
            android:textColor="@color/bt_widget_gold"
            android:textSize="7sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/bt_widget_preview_asset_symbol"
            android:textColor="@color/bt_widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bt_widget_preview_chip"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="@string/bt_widget_preview_asset_currency"
            android:textColor="@color/bt_widget_text_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/bt_widget_preview_asset_subline"
        android:textColor="@color/bt_widget_text_muted"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="@string/bt_widget_preview_asset_price"
        android:textColor="@color/bt_widget_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bt_widget_preview_pill_gain"
        android:maxLines="1"
        android:paddingHorizontal="7dp"
        android:paddingVertical="4dp"
        android:text="@string/bt_widget_preview_asset_day"
        android:textColor="@color/bt_widget_gain"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
