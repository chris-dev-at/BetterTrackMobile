<?xml version="1.0" encoding="utf-8"?>
<!--
  Net-worth widget (at.bettertrack.app.widget.BtNetWorthWidget).

  initialLayout is Glance's own loading layout — the view for the instant
  between placement and the first `provideGlance` pass. previewLayout (API 31+)
  and previewImage (older pickers) are SAMPLE renderings with dummy data, so the
  picker shows what the widget looks like instead of a spinner.

  updatePeriodMillis is 0 ON PURPOSE: BtWidgetScheduler's connectivity-
  constrained WorkManager job owns the cadence (the platform alarm wakes the
  device and cannot be constrained).

  minResizeHeight is ONE cell: the former separate "mini" widget is now this
  widget's strip breakpoint, so a placement can shrink to a 2x1 line.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="at.bettertrack.app.widget.BtNetWorthWidgetConfigActivity"
    android:description="@string/bt_widget_net_worth_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="150dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="48dp"
    android:minWidth="140dp"
    android:previewImage="@drawable/bt_widget_preview_img_net_worth"
    android:previewLayout="@layout/bt_widget_preview_net_worth"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
