<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-actions widget (at.bettertrack.app.widget.BtQuickActionsWidget), owner
  order 2026-08-16: one-tap shortcuts into the entry forms. No configuration —
  the tiles ARE the widget. Same initialLayout / updatePeriodMillis / preview
  reasoning as bt_widget_net_worth_info.xml.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/bt_widget_actions_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="260dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/bt_widget_preview_img_actions"
    android:previewLayout="@layout/bt_widget_preview_actions"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
