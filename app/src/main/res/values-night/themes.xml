<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NIGHT configuration (B2 design spec §1.5 B7). Same host role as the day
      twin in res/values/themes.xml; the only difference is that the window and
      splash backgrounds follow the real @color/bt_bg token here, because in this
      configuration the token is already the dark page colour and needs no pin.
    -->
    <style name="Theme.BetterTrack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bt_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.BetterTrack.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bt_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_bt_glyph</item>
        <item name="postSplashScreenTheme">@style/Theme.BetterTrack</item>
    </style>
</resources>
