<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OAuth token exchange, /auth/me, and all future API calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Step 16 (§6.11): Android 13+ runtime notification permission. It is
      requested IN CONTEXT (from notification settings / the inbox prompt) — never
      on cold first launch — so no auto-prompt appears at install time.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Step 17 (§5): local app lock. USE_BIOMETRIC (API 28+) lets BiometricPrompt
      offer fingerprint/face unlock as the convenience path over the local PIN.
      The PIN itself is Keystore-hashed on-device; this is separate from the
      phone's own lockscreen and from the user's web-app PIN.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      The sheet's notch detent (BtHaptics.detent, 2026-08-09) picks its own
      VibrationEffect instead of letting the platform choose one, because the
      constant Compose sends resolves to a pattern too light to feel on the test
      phone's 40%-intensity touch channel. Choosing the effect means calling
      Vibrator directly, and that needs this permission — a normal one, granted at
      install with no prompt.

      It changes nothing about who is in charge: the vibration is still tagged
      USAGE_TOUCH, so the same system switch that silenced the old path silences
      this one, and the same intensity slider scales it.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      REQUEST_INSTALL_PACKAGES is NOT here: it is the self-update permission and
      lives ONLY in the `github` flavor (app/src/github/AndroidManifest.xml). Play
      builds must not declare it (Device-and-Network-Abuse policy forbids
      self-update), so it stays out of the shared main manifest.

      AD_ID: the app has no ads and no analytics SDK, and the Data Safety form says
      so. If Firebase (or any transitive dependency) injects the advertising-ID
      permission, strip it from the merged manifest of every flavor.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
      Package visibility (Android 11+): we open the OAuth authorize page in a
      Chrome Custom Tab and the web "Need an account?/Forgot password?" links in
      a browser, so we must be able to see browser apps + the Custom Tabs service.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".BetterTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterTrack"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BetterTrack.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              OAuth 2.0 redirect deep link (§4): bettertrack://oauth/callback.
              singleTask above means a warm callback lands in onNewIntent and a
              cold callback in onCreate — both handled; the shell never stacks.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${oauthRedirectScheme}"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!--
          Step 16 (§6.11): Firebase Cloud Messaging entry point. onMessageReceived
          posts to a channel + the in-app inbox; onNewToken hands the token to the
          (stubbed) device-token register. Real end-to-end push delivery is
          platform-gated (server FCM sender + device-token endpoint).
        -->
        <service
            android:name=".data.push.BtMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.messaging.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Dev in-app update (owner ask 2026-07-12): receives the PackageInstaller
          session callbacks (pending-user-action → launch the confirm sheet;
          success/failure → cleanup/retry). Explicit + not exported: only our own
          committed session's PendingIntent can trigger it.
        -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <!--
          Home-screen widgets (Jetpack Glance) — the seven-card set of the
          2026-08-16 redesign (see BtWidgets' KDoc for the composition).

          All are `exported="true"`, which is REQUIRED and is not a widening of
          the app's surface: the launcher is a different process and cannot bind
          an unexported AppWidget provider, so a widget receiver that is not
          exported simply never appears in the picker. What crosses the boundary
          is only the AppWidget framework's own broadcasts — the receiver reads
          no data from the intent, it asks Room.

          Each one pairs with its `appwidget-provider` meta-data XML in res/xml,
          which is where the sizes, the previews and the picker description live.
          BtWidgetManifestTest pins that pairing: a receiver added here without
          its XML (or pointing at a class that does not exist) fails the build,
          because the failure mode otherwise is a widget that is silently absent
          from the picker with nothing logged.
        -->
        <receiver
            android:name=".widget.BtNetWorthWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_net_worth_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_net_worth_info" />
        </receiver>

        <receiver
            android:name=".widget.BtPortfolioWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_portfolio_pick_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_portfolio_info" />
        </receiver>

        <receiver
            android:name=".widget.BtAssetWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_asset_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_asset_info" />
        </receiver>

        <receiver
            android:name=".widget.BtWatchlistWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_watchlist_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_watchlist_info" />
        </receiver>

        <receiver
            android:name=".widget.BtMoversWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_movers_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_movers_info" />
        </receiver>

        <receiver
            android:name=".widget.BtBudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_budget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_budget_info" />
        </receiver>

        <receiver
            android:name=".widget.BtSpendingWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_spending_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_spending_info" />
        </receiver>

        <!--
          Quick Links. The receiver keeps its round-1 name because the framework
          addresses placed instances by ComponentName — renaming it would turn
          every existing Quick-actions placement into a dead launcher
          placeholder. Only the label, the provider XML and the Glance class
          behind it changed. See BtQuickActionsWidgetReceiver's KDoc.
        -->
        <receiver
            android:name=".widget.BtQuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_actions_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_quick_links_info" />
        </receiver>

        <receiver
            android:name=".widget.BtCashWalletWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_cash_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_cash_info" />
        </receiver>

        <receiver
            android:name=".widget.BtAllocationWidgetReceiver"
            android:exported="true"
            android:label="@string/bt_widget_allocation_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bt_widget_allocation_info" />
        </receiver>

        <!--
          Widget configuration steps (asset / portfolio / budget pickers).
          Exported with the APPWIDGET_CONFIGURE filter because the HOST launches
          them — a launcher is another app, and an unexported configure Activity
          is a widget that can never finish placement. Each guards itself: no
          valid EXTRA_APPWIDGET_ID ⇒ immediate finish, and the result defaults
          to CANCELED so the host deletes the placement on any failure. The
          portfolio and budget widgets mark their config OPTIONAL in their
          provider XML — placement never blocks on them; the picker is for
          narrowing a card that already works.
        -->
        <activity
            android:name=".widget.BtAssetWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtPortfolioWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtBudgetWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtNetWorthWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtAllocationWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtWatchlistWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtMoversWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtSpendingWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtQuickLinksWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BtCashWalletWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BetterTrack">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- FCM defaults for notifications posted by the system (background data). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bt" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/bt_gold" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bt_general" />

        <!--
          Step 18 (§6.12): per-app language (EN/DE). appcompat's autoStoreLocales
          service persists the AppCompatDelegate application-locale on API < 33 and
          re-applies it on process start; on API 33+ the framework LocaleManager
          owns persistence and this service no-ops. Enables the in-app language
          switch to survive restarts on every supported API level.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          Lets the tax-report CSV export leave the app through the share sheet.

          `exported="false"` + `grantUriPermissions="true"` is the pair that
          matters: no other app may query this provider on its own, and the only
          way to read anything through it is a URI we handed over inside an
          Intent carrying FLAG_GRANT_READ_URI_PERMISSION — a grant scoped to that
          one file and revoked when the receiving activity finishes.

          The authority is derived from ${applicationId} rather than written out,
          because both product flavors ship the same id today and a future suffix
          must not silently break sharing (or, worse, make two installed builds
          fight over one authority, which is an install-time failure).

          See res/xml/file_paths.xml for why the declared path is one cache
          subdirectory and not the whole cache.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
