<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      DEBUG build type only: permit cleartext HTTP to the local dev stack (and
      only to it) so a debug build can be pointed at the API over `adb reverse`.
      The policy itself is in res/xml/network_security_config.xml in this same
      source set — neither file is merged into a release build, so the shipped
      app keeps Android's default "TLS or nothing".
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
